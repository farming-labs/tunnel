{
  "name": "@farm.js/tunnel",
  "version": "0.1.0",
  "description": "Persistent Rust N-API preview tunnel for Farm.js",
  "license": "MIT",
  "keywords": [
    "farm.js",
    "tunnel",
    "preview",
    "napi-rs",
    "rust"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test test/native.test.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "napi": {
    "binaryName": "tunnel",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc"
    ],
    "packageName": "@farm.js/tunnel"
  },
  "optionalDependencies": {
    "@farm.js/tunnel-darwin-arm64": "0.1.0",
    "@farm.js/tunnel-darwin-x64": "0.1.0",
    "@farm.js/tunnel-linux-arm64-gnu": "0.1.0",
    "@farm.js/tunnel-linux-arm64-musl": "0.1.0",
    "@farm.js/tunnel-linux-x64-gnu": "0.1.0",
    "@farm.js/tunnel-linux-x64-musl": "0.1.0",
    "@farm.js/tunnel-win32-arm64-msvc": "0.1.0",
    "@farm.js/tunnel-win32-x64-msvc": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/tunnel.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
