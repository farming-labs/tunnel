{
  "name": "@farm.js/tunnel",
  "version": "0.1.0",
  "description": "Persistent Rust N-API preview tunnel for Farm.js",
  "license": "MIT",
  "keywords": [
    "farm.js",
    "tunnel",
    "preview",
    "napi-rs",
    "rust"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "napi": {
    "binaryName": "tunnel",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc"
    ],
    "packageName": "@farm.js/tunnel"
  },
  "repository": "https://github.com/farming-labs/tunnel",
  "publishConfig": {
    "access": "public"
  }
}
